          }
        },
        "description": "Task assignments for the deleted user are cleared. The final admin is protected."
      }
    }
  },
  "components": {
    "schemas": {
      "ServerFields": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "[^\\s\\u0085]"
          },
          "hostname": {
