    },
    "/api/maintenance-tasks": {
      "get": {
        "tags": ["Maintenance tasks"],
        "summary": "List maintenance tasks by ID",
        "responses": {
          "200": {
            "description": "Maintenance tasks records.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MaintenanceTask"
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "post": {
        "tags": ["Maintenance tasks"],
        "summary": "Create a maintenance task",
        "description": "Exactly one target is required. When switching target type, set the old field to null. Completing a task requires a nonblank outcome. Reopening clears the completion time.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MaintenanceTaskCreate"
              },
              "example": {
                "title": "Check backups",
                "server_id": 1,
                "due_on": "2026-11-30"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "MaintenanceTask created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MaintenanceTask"
                }
              }
            },
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                },
                "description": "URL path of the created record."
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/maintenance-tasks/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RecordId"
        }
      ],
      "get": {
        "tags": ["Maintenance tasks"],
        "summary": "Get a maintenance task",
        "responses": {
          "200": {
            "description": "MaintenanceTask record.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MaintenanceTask"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "patch": {
        "tags": ["Maintenance tasks"],
        "summary": "Update supplied maintenance task fields",
        "description": "Omitted fields retain their saved values. The resulting task must have exactly one target. When switching target type, set the old field to null and use the ID of an existing server or deployment. The example assumes deployment 1 exists. Completing a task requires a nonblank outcome. Reopening clears the completion time.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MaintenanceTaskPatch"
              },
              "example": {
                "server_id": null,
                "deployment_id": 1
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "MaintenanceTask record.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MaintenanceTask"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "tags": ["Maintenance tasks"],
        "summary": "Delete a maintenance task",
        "responses": {
          "204": {
            "description": "MaintenanceTask deleted."
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/users": {
      "get": {
