{
  "openapi": "3.1.0",
  "info": {
    "title": "Homelab Ledger API",
    "version": "0.3.0",
    "description": "Milestone 3 API for local sample data. This loopback preview has no authentication. Deployment statuses and server specifications describe recorded inventory."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/servers": {
      "get": {
        "tags": ["Servers"],
        "summary": "List servers by ID",
        "responses": {
          "200": {
            "description": "Server records.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Server"
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "post": {
        "tags": ["Servers"],
        "summary": "Create a server",
        "responses": {
          "201": {
            "description": "Server created.",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                },
                "description": "URL path of the new server."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Server"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ServerCreate"
              },
              "example": {
                "name": "Archive server",
                "hostname": "archive.example.test",
                "purpose": "Sample storage",
                "ram_mib": 4096
              }
            }
          }
        }
      }
    },
    "/api/servers/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RecordId"
        }
      ],
      "get": {
        "tags": ["Servers"],
        "summary": "Get a server",
        "responses": {
          "200": {
            "description": "Server record.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Server"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "patch": {
        "tags": ["Servers"],
        "summary": "Update supplied server fields",
        "responses": {
          "200": {
            "description": "Server record.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Server"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ServerPatch"
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Servers"],
        "summary": "Delete a server",
        "responses": {
          "204": {
            "description": "Server deleted."
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/applications": {
      "get": {
        "tags": ["Applications"],
        "summary": "List applications by ID",
        "responses": {
          "200": {
            "description": "Applications records.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Application"
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "post": {
        "tags": ["Applications"],
        "summary": "Create a application",
        "description": "Provide a GitHub owner and repository together. Clear a link by setting both fields to empty strings.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApplicationCreate"
              },
              "example": {
                "name": "Immich",
                "description": "Photo library",
                "github_owner": "immich-app",
                "github_repo": "immich"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Application created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Application"
                }
              }
            },
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                },
                "description": "URL path of the created record."
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/applications/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RecordId"
        }
      ],
      "get": {
        "tags": ["Applications"],
        "summary": "Get a application",
        "responses": {
          "200": {
            "description": "Application record.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Application"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "patch": {
        "tags": ["Applications"],
        "summary": "Update supplied application fields",
        "description": "Omitted fields retain their saved values. The service validates the repository pair after applying supplied fields. Use empty strings for both fields to unlink the application.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApplicationPatch"
              },
              "example": {
                "github_owner": "",
                "github_repo": ""
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Application record.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Application"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "tags": ["Applications"],
        "summary": "Delete a application",
        "responses": {
          "204": {
            "description": "Application deleted."
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/applications/{id}/release": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RecordId"
        }
      ],
      "get": {
        "tags": ["Applications"],
        "summary": "Get the latest published GitHub release",
        "description": "Reads the GitHub repository saved on the application and returns the published tag and release-notes link when available.",
        "responses": {
          "200": {
            "description": "Release information, a reachable repository with no release, or an unlinked application.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ReleaseAvailable"
                    },
                    {
                      "$ref": "#/components/schemas/NoRelease"
                    },
                    {
                      "$ref": "#/components/schemas/UnlinkedRelease"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "502": {
            "description": "GitHub is unavailable, the repository is inaccessible, or the upstream response is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReleaseUnavailable"
                }
              }
            }
          },
          "503": {
            "description": "GitHub rate limited the lookup.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReleaseRateLimited"
                }
              }
            }
          }
        }
      }
    },
    "/api/deployments": {
      "get": {
        "tags": ["Deployments"],
        "summary": "List deployments by ID",
        "responses": {
          "200": {
